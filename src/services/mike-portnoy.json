  "band_member": {
    "name": "Mike Portnoy",
    "role": "Drums",
    "tenure": "1985–2010, 2023–present",
    "bio": {
      "overview": "Mike Portnoy is a founding member and former drummer of the progressive metal band Dream Theater, renowned for his technical mastery, complex time signatures, and innovative drumming style.",
      "extended_bio": [
        "Co-founded Dream Theater at Berklee College of Music in 1985 with John Petrucci and John Myung",
        "Played on iconic albums including Images and Words, Metropolis Pt. 2: Scenes from a Memory, and Black Clouds & Silver Linings",
        "Rejoined Dream Theater in 2023 for their 40th-anniversary tour"
      ]
    },
